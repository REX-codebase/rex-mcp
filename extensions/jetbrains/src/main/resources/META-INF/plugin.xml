<idea-plugin>
    <id>com.rex.ide</id>
    <name>REX</name>
    <vendor>rex corp</vendor>

    <description><![CDATA[
        Drive the local REX harness without leaving the IDE.
        Spawns <code>rex serve</code>, runs tasks, surfaces plan and tool-call
        approvals as notifications, and offers workspace checkpoint/rewind.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="rex.approvals"
                           displayType="STICKY_BALLOON"
                           isLogByDefault="true"/>
        <applicationService serviceImplementation="com.rex.ide.RexService"/>
    </extensions>

    <actions>
        <action id="rex.RunTask" class="com.rex.ide.actions.RexRunTaskAction"
                text="REX: Run Task…" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="rex.CancelRun" class="com.rex.ide.actions.RexCancelAction"
                text="REX: Cancel Active Run" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="rex.Checkpoint" class="com.rex.ide.actions.RexCheckpointAction"
                text="REX: Checkpoint Run Workspace" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="rex.Rewind" class="com.rex.ide.actions.RexRewindAction"
                text="REX: Rewind Run to Checkpoint…" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
        <action id="rex.ShowReceipt" class="com.rex.ide.actions.RexShowReceiptAction"
                text="REX: Show Run Receipt" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
