{
  "name": "rex-bench",
  "image": "mcr.microsoft.com/devcontainers/base:debian",
  "postCreateCommand": "bash benchmark/codespace/setup.sh",
  "forwardPorts": [8787, 8788],
  "portsAttributes": {
    "8787": { "label": "rex-dev-server (private)" },
    "8788": { "label": "rex-key-fill (private, one-shot)" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": []
    }
  }
}
